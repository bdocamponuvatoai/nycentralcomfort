# Public URL of the production site (canonical URLs, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=https://nycentralcomfort.net

# Quote form email delivery (https://resend.com). Verify the sending domain in Resend first.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=NY Central Comfort <website@nycentralcomfort.net>
INQUIRY_TO_EMAIL=info@nycentralcomfort.net

# Rate limiting across all serverless instances (optional; falls back to in-memory).
# Either Upstash names or the Vercel Marketplace KV names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
